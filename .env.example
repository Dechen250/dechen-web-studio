# Copie para .env na VPS. Nunca commite o .env.

NODE_ENV=production
SITE_AUDIT_ENABLED=1
CHROME_NO_SANDBOX=1
CHROME_PATH=/usr/bin/chromium

# Local: 127.0.0.1:3000. Nesta VPS: 172.17.0.1:3003 (3000–3002 já estão ocupadas).
DWS_PUBLISH=127.0.0.1:3000

# Senha do console /ops (mínimo 8 caracteres). Obrigatória em produção.
OPS_SECRET=

# Opcional. Sem chave a cota pública do Google acaba rápido.
PAGESPEED_API_KEY=

# CRM (crm.dechenwebstudio.com.br). Na VPS use a porta interna 3002.
CRM_INGEST_URL=http://172.17.0.1:3002/api/ingest/leads
CRM_INGEST_SECRET=
